# Copy to .env.local. Every variable is optional: with none set the app runs with no
# product source (players paste listing links), no AI try-on and default branding.

# --- Streamer branding ------------------------------------------------------
APP_NAME=FIT/DUEL
# Shown as "fitduel × NAME" in the nav, stream view and share card.
STREAMER_NAME=
# Shown in the homepage "live on …" sticker, e.g. @yourchannel
STREAMER_HANDLE=
# https:// link to the channel (optional)
STREAMER_URL=
# Logo: a file in /public (e.g. /brand/logo.png) or an https:// URL. Shown round, 1:1.
STREAMER_LOGO_URL=
# Player colours as #RRGGBB: P1 = player 1 / main accent, P2 = player 2.
BRAND_P1=#6B3BFF
BRAND_P2=#2E5CFF

# --- Storage -----------------------------------------------------------------
# Folder for the SQLite database and private try-on photos. Default: ./data
DATA_DIR=./data

# --- Authorized Grailed listing data ----------------------------------------
# Grailed has no public API. Only use a feed you have PERMISSION to use
# (e.g. a partner/affiliate export). Format: see README.
# Per-listing lookup, used when a player pastes a link. {id} = Grailed listing id.
GRAILED_LISTING_LOOKUP_URL=
GRAILED_FEED_URL=
GRAILED_FEED_TOKEN=
GRAILED_FEED_FILE=
GRAILED_FEED_TTL_SECONDS=300

# --- AI try-on (fal.ai) ------------------------------------------------------
# Server-side only; never exposed to the browser. Leave empty to disable try-on.
FAL_KEY=
# Dedicated try-on model for tops, bottoms, outerwear (~$0.075 per garment).
FAL_TRYON_ENDPOINT=https://fal.run/fal-ai/fashn/tryon/v1.6
# General multi-image editor for shoes, accessories, bags (~$0.039 per image).
FAL_EDIT_ENDPOINT=https://fal.run/fal-ai/nano-banana/edit
# "off" = only tops/bottoms/outerwear are visualized.
TRYON_EXTRAS=on
# Max try-on runs per user per 24 h (cost control).
TRYON_DAILY_LIMIT=12

# --- Test only. NEVER set in production. ------------------------------------
# Lets the image fetcher reach localhost/private IPs (used by the contract and image tests).
# IMAGE_FETCH_ALLOW_PRIVATE=1
